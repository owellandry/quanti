// Branching + when + @runtime demo
@runtime(max_branches: 32, prune_threshold: 0.01)

karu hypothesis = superposition(0, 1);
int score = 0;

if (hypothesis) {
    score = 10;
} else {
    score = 3;
}

print(score);

when (hypothesis) {
    print(1);
}

karu decision = P(Discrete([0.8, 0.2], ["act", "wait"]));
print(measure:map(decision));
